# Copy to .env and adjust as needed.
# All client variables must be prefixed with VITE_ so Vite exposes them.

# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL for API requests. Leave empty to use same-origin "/api" (and Vite proxy in dev).
# Example for external backend: https://your-backend.com/api
VITE_API_BASE_URL=

# ─── Dev server (only used when running "npm run dev") ─────────────────────────
VITE_DEV_SERVER_PORT=3000
VITE_DEV_PROXY_TARGET=http://localhost:5001

# ─── App (optional) ─────────────────────────────────────────────────────────
# VITE_APP_TITLE=YouTube Dashboard
